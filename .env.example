# MongoDB
# This single connection is used for everything — application data AND
# media storage. Uploaded images/graphics/videos are stored directly in
# this database via GridFS (see lib/storage/gridfs-provider.ts) — there is
# no separate media service to configure.
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/5kings-global?retryWrites=true&w=majority

# Auth
# Generate a strong random string, e.g. `openssl rand -base64 48`
SESSION_SECRET=

# Site
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# One-time admin seeding (only used by `npm run seed`, never used at runtime)
SEED_ADMIN_NAME="Site Administrator"
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
